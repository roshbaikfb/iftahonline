# /etc/iftahonline/worker.env  (root:root, mode 0600). See internal/platform/config.
APP_ENV=production
LOG_LEVEL=info
HTTP_ADDR=127.0.0.1:8082
DATABASE_URL=postgres://app_user:CHANGE_ME@db.internal:5432/iftah?sslmode=verify-full
REDIS_URL=rediss://:CHANGE_ME@redis.internal:6379/0
PLATFORM_BASE_DOMAIN=iftahonline.com
REDIS_URL=rediss://:CHANGE_ME@redis.internal:6379/0
PLATFORM_BASE_DOMAIN=iftahonline.com
TRUSTED_PROXIES=127.0.0.1/32
DRAIN_DELAY=5s
SHUTDOWN_TIMEOUT=20s
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
# From the secret manager: 32 random bytes each, base64 (openssl rand -base64 32).
SECRETBOX_KEYS=1:CHANGE_ME
OTP_PEPPER=CHANGE_ME
# Outgoing mail (any SMTP provider). Unset: a masked notice is logged instead.
# SMTP_ADDR=smtp.provider.example:587
# SMTP_USERNAME=CHANGE_ME
# SMTP_PASSWORD=CHANGE_ME
MAIL_FROM=iftahonline <no-reply@iftahonline.com>
DASHBOARD_URL=https://app.iftahonline.com
# Media: S3-compatible object storage and imgproxy. Key and salt: from the
# secret manager, hex (openssl rand -hex 32), identical in imgproxy's env.
S3_ENDPOINT=https://s3.CHANGE_ME.example
# S3_PUBLIC_ENDPOINT=https://media-upload.iftahonline.com
S3_REGION=CHANGE_ME
S3_BUCKET=CHANGE_ME
S3_ACCESS_KEY=CHANGE_ME
S3_SECRET_KEY=CHANGE_ME
IMGPROXY_URL=https://img.iftahonline.com
IMGPROXY_KEY=CHANGE_ME
IMGPROXY_SALT=CHANGE_ME
# Concurrent image jobs; each holds one decoded image (<= MEDIA_MAX_IMAGE_PIXELS x 4 bytes).
MEDIA_IMAGE_WORKERS=2
# Search: Meilisearch, never the master key (see deploy/README.md for the
# actions each role's key needs on MEILI_INDEX).
MEILI_URL=https://search.internal:7700
MEILI_API_KEY=CHANGE_ME
MEILI_INDEX=products
# Edge cache purge by tag (ADR-0019). Token with Zone > Cache Purge only.
CLOUDFLARE_ZONE_ID=CHANGE_ME
CLOUDFLARE_API_TOKEN=CHANGE_ME
