# /etc/iftahonline/api.env  (root:root, mode 0600). See internal/platform/config.
APP_ENV=production
LOG_LEVEL=info
HTTP_ADDR=127.0.0.1:8080
DATABASE_URL=postgres://app_user:CHANGE_ME@db.internal:5432/iftah?sslmode=verify-full
REDIS_URL=rediss://:CHANGE_ME@redis.internal:6379/0
PLATFORM_BASE_DOMAIN=iftahonline.com
# Password hashing (argon2id). Peak memory = ARGON2_MEMORY_KIB x PASSWORD_HASH_CONCURRENCY.
ARGON2_MEMORY_KIB=19456
ARGON2_TIME=2
PASSWORD_HASH_CONCURRENCY=8
PLATFORM_BASE_DOMAIN=iftahonline.com
TRUSTED_PROXIES=127.0.0.1/32
# Where merchants point custom domains (ADR-0037). Point the target at the
# edge; list the edge's fixed public addresses for apex domains.
CUSTOM_DOMAIN_TARGET=connect.iftahonline.com
CUSTOM_DOMAIN_IPV4=CHANGE_ME
# CUSTOM_DOMAIN_IPV6=
DRAIN_DELAY=5s
SHUTDOWN_TIMEOUT=20s
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
# From the secret manager: 32 random bytes each, base64 (openssl rand -base64 32).
SECRETBOX_KEYS=1:CHANGE_ME
OTP_PEPPER=CHANGE_ME
# Outgoing mail (any SMTP provider). Unset: a masked notice is logged instead.
# SMTP_ADDR=smtp.provider.example:587
# SMTP_USERNAME=CHANGE_ME
# SMTP_PASSWORD=CHANGE_ME
MAIL_FROM=iftahonline <no-reply@iftahonline.com>
DASHBOARD_URL=https://app.iftahonline.com
# Super-admin console: app_admin role (see deploy/README.md). Unset = console off.
# ADMIN_DATABASE_URL=postgres://app_admin:CHANGE_ME@db.internal:5432/iftah?sslmode=verify-full
# ADMIN_HOST=admin.iftahonline.com
# Media: S3-compatible object storage and imgproxy. Key and salt: from the
# secret manager, hex (openssl rand -hex 32), identical in imgproxy's env.
S3_ENDPOINT=https://s3.CHANGE_ME.example
# S3_PUBLIC_ENDPOINT=https://media-upload.iftahonline.com
S3_REGION=CHANGE_ME
S3_BUCKET=CHANGE_ME
S3_ACCESS_KEY=CHANGE_ME
S3_SECRET_KEY=CHANGE_ME
IMGPROXY_URL=https://img.iftahonline.com
IMGPROXY_KEY=CHANGE_ME
IMGPROXY_SALT=CHANGE_ME
# Search: Meilisearch, never the master key (see deploy/README.md for the
# actions each role's key needs on MEILI_INDEX).
MEILI_URL=https://search.internal:7700
MEILI_API_KEY=CHANGE_ME
MEILI_INDEX=products
# Customer messages (ADR-0038/0039; docs/go-live.md). WhatsApp: the four go
# together, from the platform's Meta app; SMS: the three go together. Unset:
# that channel is off (orders then wait for the merchant to confirm).
# WHATSAPP_PHONE_NUMBER_ID=CHANGE_ME
# WHATSAPP_ACCESS_TOKEN=CHANGE_ME
# WHATSAPP_APP_SECRET=CHANGE_ME
# WHATSAPP_VERIFY_TOKEN=CHANGE_ME
# WHATSAPP_DISPLAY_NUMBER=+201000000000
# TWILIO_ACCOUNT_SID=ACCHANGE_ME
# TWILIO_AUTH_TOKEN=CHANGE_ME
# TWILIO_FROM=CHANGE_ME
# Messages a store may send per month until plans arrive (P7).
ENTITLEMENTS_MESSAGES_PER_MONTH=500
