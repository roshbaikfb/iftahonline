# /etc/iftahonline/storefront.env  (root:root, mode 0600). See internal/platform/config.
APP_ENV=production
LOG_LEVEL=info
HTTP_ADDR=127.0.0.1:8081
DATABASE_URL=postgres://app_user:CHANGE_ME@db.internal:5432/iftah?sslmode=verify-full
REDIS_URL=rediss://:CHANGE_ME@redis.internal:6379/0
# Same value as the api and worker (ADR-0065); never rotated.
RISK_PHONE_KEY=CHANGE_ME
PLATFORM_BASE_DOMAIN=iftahonline.com
# Image delivery only: the storefront signs imgproxy URLs and never
# reads or writes the bucket, so it has no S3 credentials.
S3_BUCKET=CHANGE_ME
IMGPROXY_URL=https://img.iftahonline.com
IMGPROXY_KEY=CHANGE_ME
IMGPROXY_SALT=CHANGE_ME
# How long the edge (Cloudflare) may keep a page. Keep 60s or less unless
# the worker purges (CLOUDFLARE_* in worker.env); then e.g. 10m.
EDGE_CACHE_TTL=10m
TRUSTED_PROXIES=127.0.0.1/32
DRAIN_DELAY=5s
SHUTDOWN_TIMEOUT=20s
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
# The API host card shoppers pay through (ADR-0030); default
# https://app.<PLATFORM_BASE_DOMAIN>. The storefront holds no gateway keys.
CHECKOUT_URL=https://app.iftahonline.com
# Shoppers' search: Meilisearch with a key limited to searching MEILI_INDEX
# (never the master key). Unset: the storefront offers no search.
MEILI_URL=https://search.internal:7700
MEILI_SEARCH_KEY=CHANGE_ME
MEILI_INDEX=products
# The platform's WhatsApp number (E.164, public): the thank-you page's
# "confirm on WhatsApp" button (ADR-0041). Unset: no button.
# WHATSAPP_DISPLAY_NUMBER=+201000000000
