# Local development environment for `make dev` (copy to .env to override).
# Every variable is documented in internal/platform/config.
APP_ENV=development
LOG_LEVEL=debug
DATABASE_URL=postgres://app_user:app_user@localhost:15432/iftah?sslmode=disable
MIGRATE_DATABASE_URL=postgres://app_owner:app_owner@localhost:15432/iftah?sslmode=disable
REDIS_URL=redis://localhost:16379/0
DRAIN_DELAY=0s
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# Not read by the platform yet (later phases); listed for the local stack:
MEILI_URL=http://localhost:17700
MEILI_MASTER_KEY=local-dev-master-key-0123456789
S3_ENDPOINT=http://localhost:18333
S3_BUCKET=iftah-media
S3_ACCESS_KEY=local-dev-access
S3_SECRET_KEY=local-dev-secret-not-for-prod
SMTP_ADDR=localhost:11025
