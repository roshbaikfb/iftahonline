# Local development environment for `make dev` (copy to .env to override).
# Every variable is documented in internal/platform/config.
APP_ENV=development
LOG_LEVEL=debug
DATABASE_URL=postgres://app_user:app_user@localhost:15432/iftah?sslmode=disable
MIGRATE_DATABASE_URL=postgres://app_owner:app_owner@localhost:15432/iftah?sslmode=disable
# Super-admin console (served on ADMIN_HOST, default admin.<PLATFORM_BASE_DOMAIN>).
ADMIN_DATABASE_URL=postgres://app_admin:app_admin@localhost:15432/iftah?sslmode=disable
REDIS_URL=redis://localhost:16379/0
# Browsers resolve *.localhost to 127.0.0.1, so store subdomains work locally.
PLATFORM_BASE_DOMAIN=iftahonline.localhost
DRAIN_DELAY=0s
# Development-only keys, published on purpose: they decode to
# "dev-only-secretbox-key-32-bytes!" and "dev-only-otp-pepper-not-a-secret".
# Production values come from the secret manager (32 random bytes each).
SECRETBOX_KEYS=1:ZGV2LW9ubHktc2VjcmV0Ym94LWtleS0zMi1ieXRlcyE=
OTP_PEPPER=ZGV2LW9ubHktb3RwLXBlcHBlci1ub3QtYS1zZWNyZXQ=
# Mailpit from deploy/compose catches every email (UI: http://localhost:18025).
SMTP_ADDR=localhost:11025
DASHBOARD_URL=http://localhost:5173
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# Media: SeaweedFS (S3) and imgproxy from deploy/compose. The imgproxy key
# and salt are development-only hex values, published on purpose; they
# must match deploy/compose/docker-compose.yml.
S3_ENDPOINT=http://localhost:18333
S3_BUCKET=iftah-media
S3_ACCESS_KEY=local-dev-access
S3_SECRET_KEY=local-dev-secret-not-for-prod
IMGPROXY_URL=http://localhost:18088
IMGPROXY_KEY=6465762d6f6e6c792d696d6770726f78792d6b65792d6e6f742d736563726574
IMGPROXY_SALT=6465762d6f6e6c792d696d6770726f78792d73616c742d7075626c6963

# Meilisearch from deploy/compose; in development the master key is the
# API key. Production uses a key limited to the products index.
MEILI_URL=http://localhost:17700
MEILI_API_KEY=local-dev-master-key-0123456789

# Carriers (ADR-0026). The fake carrier lets you try shipments locally;
# Bosta's staging API needs a key from Bosta.
SHIPPING_FAKE_CARRIER=true
# BOSTA_BASE_URL=https://stg-app.bosta.co/api/v2

# Card gateways (ADR-0029). The fake gateway lets you try card checkout
# locally; Paymob's test mode needs test keys from your Paymob account.
PAYMENTS_FAKE_GATEWAY=true
# PAYMOB_BASE_URL=https://accept.paymob.com
# The storefront sends card shoppers to the API host (ADR-0030); locally,
# through the dashboard's dev server, which proxies /v1 to the api.
CHECKOUT_URL=http://localhost:5173
