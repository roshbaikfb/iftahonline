package web

// aboutPage is who we are. The founders, the team and the founding
// story come with the console (S4) and show once they are set.
templ aboutPage(p *pageCtx) {
	<section class="dots">
		<div class="wrap page-head">
			@crumbs(p, p.t.About)
			<h1>{ p.t.AboutH1 }</h1>
			<p class="lead">{ p.t.AboutLead }</p>
		</div>
	</section>
	<section class="wrap section tight story" aria-labelledby="h-story">
		<h2 id="h-story">{ p.t.WhyH2About }</h2>
		<p>{ p.t.WhyP1 }</p>
		<p>{ p.t.WhyP2 }</p>
	</section>
	<section class="soft" aria-labelledby="h-values">
		<div class="wrap section tight">
			<h2 id="h-values" class="center">{ p.t.ValuesH2 }</h2>
			<div class="grid3 control">
				for _, v := range p.c.values {
					<div class="card">
						<h3>{ v.title }</h3>
						<p>{ v.body }</p>
					</div>
				}
			</div>
		</div>
	</section>
	<section class="wrap section tight" aria-labelledby="h-company">
		<h2 id="h-company" class="center">{ p.t.CompanyH2 }</h2>
		<div class="grid2 company">
			<div class="card">
				<div class="company-head">
					@templ.Raw(flagSVG(p.t.UKFlag))
					<div>
						<h3 dir="ltr">Codezilo Ltd</h3>
						<p>{ p.t.RegisteredUK }</p>
					</div>
				</div>
				<p>{ p.t.BrandOf }</p>
				<address dir="ltr">5c New Quebec Street<br/>London W1H 7RG<br/>United Kingdom</address>
			</div>
			<div class="card">
				<h3>{ p.t.Contact }</h3>
				<p>{ p.t.ContactLead }</p>
				if p.whatsApp != "" {
					<a class="btn primary" href={ templ.SafeURL(p.whatsApp) } rel="noopener" target="_blank">
						@icon("chat")
						{ p.t.WhatsApp } <bdi dir="ltr">{ p.whatsDisplay }</bdi>
					</a>
				}
			</div>
		</div>
	</section>
	@finalCTA(p)
}

templ legalPageView(p *pageCtx, lp legalPage) {
	<section class="dots">
		<div class="wrap page-head">
			@crumbs(p, lp.name)
			<h1>{ lp.h1 }</h1>
			<p class="lead">{ lp.lead }</p>
			<p class="muted small">{ p.t.LastUpdated } { p.c.legalUpdated }</p>
		</div>
	</section>
	<article class="wrap section tight prose">
		for _, sec := range lp.sections {
			<h2>{ sec.h }</h2>
			for _, para := range sec.paras {
				<p>{ para }</p>
			}
		}
	</article>
}
