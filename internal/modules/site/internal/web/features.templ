package web

templ featuresIndexPage(p *pageCtx) {
	<section class="dots">
		<div class="wrap page-head">
			@crumbs(p, p.t.Features)
			<h1>{ p.t.FeaturesH1 }</h1>
			<p class="lead">{ p.t.FeaturesLead }</p>
		</div>
	</section>
	<section class="wrap section tight" aria-label={ p.t.Features }>
		<div class="grid3 links">
			for _, f := range p.c.featurePages {
				<a class="card link" href={ templ.SafeURL(p.l.at("/features/" + f.slug)) }>
					if f.paid {
						<span class="tag blue">{ p.t.PaidOnly }</span>
					}
					<h2>{ f.name }</h2>
					<p>{ f.short }</p>
					<span class="more">{ p.t.ReadMore } { p.t.Arrow }</span>
				</a>
			}
		</div>
	</section>
	@finalCTA(p)
}

templ featurePageView(p *pageCtx, f featurePage) {
	<section class="dots">
		<div class="wrap page-head">
			@crumbs(p, f.name, crumb{p.t.Features, "/features"})
			if f.paid {
				<span class="tag blue">{ p.t.PaidOnly }</span>
			}
			<h1>{ f.h1 }</h1>
			<p class="lead">{ f.lead }</p>
			<div class="cta-row">
				<a class="btn primary big" href={ templ.SafeURL(p.signup) }>{ p.t.CreateFree }</a>
				<a class="btn ghost big" href={ templ.SafeURL(p.l.at("/pricing")) }>{ p.t.SeePrices }</a>
			</div>
		</div>
	</section>
	<section class="wrap section tight" aria-labelledby="h-how">
		<div class="feature">
			<div class="feature-text">
				<h2 id="h-how">{ f.howTitle }</h2>
				<ol class="how">
					for i, st := range f.how {
						<li>
							<span>{ stepNumber(i) }</span>
							<div>
								<h3>{ st.title }</h3>
								<p>{ st.body }</p>
							</div>
						</li>
					}
				</ol>
			</div>
			<div class={ "feature-art", f.art } aria-hidden="true">
				@art(f.art, p.t)
			</div>
		</div>
	</section>
	if len(f.control) > 0 {
		<section class="soft" aria-labelledby="h-control">
			<div class="wrap section tight">
				<h2 id="h-control" class="center">{ f.controlTitle }</h2>
				<div class="grid3 control">
					for _, c := range f.control {
						<div class="card">
							<h3>{ c.title }</h3>
							<p>{ c.body }</p>
						</div>
					}
				</div>
			</div>
		</section>
	}
	if len(f.faqs) > 0 {
		<section class="wrap section tight faq-page" aria-labelledby="h-ffaq">
			<h2 id="h-ffaq" class="center">{ p.t.QuestionsAbout } { f.name }</h2>
			@faqList(f.faqs)
		</section>
	}
	<section class="wrap section tight" aria-labelledby="h-related">
		<h2 id="h-related" class="center">{ p.t.OtherFeatures }</h2>
		<div class="grid3 links">
			for _, o := range p.c.related(f.slug) {
				<a class="card link" href={ templ.SafeURL(p.l.at("/features/" + o.slug)) }>
					<h3>{ o.name }</h3>
					<p>{ o.short }</p>
				</a>
			}
		</div>
	</section>
	@finalCTA(p)
}

// art is a feature's illustration, by name, in the page's language.
templ art(name string, t *texts) {
	switch name {
		case "confirm":
			@chatArt(t)
		case "protect":
			@riskArt(t)
		case "profit":
			@profitArt(t)
		case "shipping":
			@shipArt(t)
		case "store":
			@storeArt(t)
		case "marketing":
			@marketingArt(t)
	}
}

templ shipArt(t *texts) {
	<div class="profit">
		<div class="profit-card">
			<div class="profit-head"><strong class="plain">{ t.ShipTitle } <bdi dir="ltr">#K8M2Q4ZX</bdi></strong><span class="chip info">{ t.ShipStatus }</span></div>
			<ol class="track">
				<li class="done">{ t.ShipConfirmed }</li>
				<li class="done">{ t.ShipPicked }</li>
				<li class="now">{ t.ShipOnWay }</li>
				<li>{ t.ShipDelivered }</li>
			</ol>
		</div>
		<dl class="profit-list">
			<div><dt>{ t.ShipFee } · <em>{ t.Example }</em></dt><dd></dd></div>
			for _, z := range t.ShipZones {
				<div><dt>{ z[0] }</dt><dd>{ z[1] }</dd></div>
			}
		</dl>
	</div>
}

templ storeArt(t *texts) {
	<div class="phone">
		<div class="phone-img"></div>
		<strong>{ t.StoreProduct }</strong>
		<p class="phone-price">{ t.StorePrice } <s>{ t.StoreWas }</s></p>
		<div class="sizes"><span>S</span><span class="on">M</span><span>L</span><span>XL</span></div>
		<span class="field">{ t.StoreName }</span>
		<span class="field">{ t.StorePhone }</span>
		<span class="field">{ t.StoreArea }</span>
		<span class="phone-btn">{ t.StoreBuy }</span>
	</div>
}

templ marketingArt(t *texts) {
	<div class="profit">
		<div class="profit-card">
			<div class="profit-head"><strong class="plain">{ t.MktPixels }</strong></div>
			<ul class="pixels">
				<li>Meta<span class="chip ok">{ t.MktOn }</span></li>
				<li>TikTok<span class="chip ok">{ t.MktOn }</span></li>
				<li>Snapchat<span class="chip">{ t.MktOff }</span></li>
				<li>Google<span class="chip ok">{ t.MktOn }</span></li>
			</ul>
		</div>
		<div class="coupon">
			<strong dir="ltr">SUMMER20</strong>
			<span>{ t.MktCoupon }</span>
		</div>
	</div>
}
