package web

templ homePage(p *pageCtx, pr pricing, home []faq) {
	<section class="hero dots">
		<div class="wrap hero-in">
			<h1>{ p.t.HeroH1 } <span class="accent">{ p.t.HeroAccent }</span></h1>
			<p class="lead">{ p.t.HeroLead }</p>
			<div class="cta-row">
				<a class="btn primary big" href={ templ.SafeURL(p.signup) }>{ p.t.CreateFree }</a>
				<a class="btn ghost big" href={ templ.SafeURL(p.l.at("/pricing")) }>{ p.t.SeePrices }</a>
			</div>
			<p class="fine">{ p.t.HeroFine }</p>
			@heroShot(p.t)
		</div>
	</section>
	<section class="works" aria-label={ p.t.WorksWith }>
		<div class="wrap works-in">
			<span class="works-label">{ p.t.WorksWith }</span>
			for _, w := range p.c.worksWith {
				<span class="works-name">{ w }</span>
			}
		</div>
	</section>
	<section id="features" class="wrap section" aria-labelledby="h-why">
		<div class="head">
			<span class="eyebrow">{ p.t.WhyEyebrow }</span>
			<h2 id="h-why">{ p.t.WhyH2 }</h2>
			<p>{ p.t.WhyLead }</p>
		</div>
		for i, f := range p.c.features {
			<div class={ "feature", templ.KV("flip", i%2 == 1) } id={ f.id }>
				<div class="feature-text">
					<span class={ "tag", f.tagClass }>{ f.tag }</span>
					<h3>{ f.title }</h3>
					<p>{ f.body }</p>
					if len(f.points) > 0 {
						<ul class="ticks">
							for _, pt := range f.points {
								<li>
									@icon("check")
									{ pt }
								</li>
							}
						</ul>
					}
					<a class="more" href={ templ.SafeURL(p.l.at(f.more)) }>{ p.t.LearnMore } { f.tag } { p.t.Arrow }</a>
				</div>
				<div class={ "feature-art", f.id } aria-hidden="true">
					@art(f.id, p.t)
				</div>
			</div>
		}
	</section>
	<section class="wrap section" aria-labelledby="h-tools">
		<div class="head">
			<span class="eyebrow">{ p.t.ToolsEyebrow }</span>
			<h2 id="h-tools">{ p.t.ToolsH2 }</h2>
		</div>
		<div class="bento">
			for _, t := range p.c.tools {
				<div class={ "tile", templ.KV("wide", t.wide) }>
					<h3>{ t.title }</h3>
					<p>{ t.body }</p>
				</div>
			}
		</div>
	</section>
	<section class="dark" aria-labelledby="h-steps">
		<div class="wrap section">
			<h2 id="h-steps" class="center">{ p.t.StepsH2 }</h2>
			<ol class="steps">
				for i, st := range p.c.steps {
					<li class={ templ.KV("first", i == 0) }>
						<span class="step-n">{ p.t.Step } { stepNumber(i) }</span>
						<h3>{ st.title }</h3>
						<p>{ st.body }</p>
					</li>
				}
			</ol>
		</div>
	</section>
	<section class="wrap section" aria-labelledby="h-trust">
		<div class="head">
			<span class="eyebrow">{ p.t.TrustEyebrow }</span>
			<h2 id="h-trust">{ p.t.TrustH2 }</h2>
		</div>
		<div class="grid4">
			for _, t := range p.c.trust {
				<div class="card">
					@icon(t.icon)
					<h3>{ t.title }</h3>
					<p>{ t.body }</p>
				</div>
			}
		</div>
	</section>
	<section class="wrap section" aria-labelledby="h-move">
		<div class="move">
			<div>
				<span class="tag green">{ p.t.MoveTag }</span>
				<h2 id="h-move">{ p.t.MoveH2 }</h2>
				<p>{ p.t.MoveLead }</p>
				if p.whatsApp != "" {
					<a class="btn navy" href={ templ.SafeURL(p.whatsApp) } rel="noopener" target="_blank">{ p.t.MoveCTA }</a>
				}
			</div>
			<ol class="move-steps">
				for i, st := range p.t.MoveSteps {
					<li><span>{ stepNumber(i) }</span>{ st }</li>
				}
			</ol>
		</div>
	</section>
	<section class="wrap section" aria-labelledby="h-pricing">
		<div class="head">
			<span class="eyebrow">{ p.t.PricingEyebrow }</span>
			<h2 id="h-pricing">{ p.t.PricingH2 }</h2>
			<p>{ p.t.PricingLead }</p>
		</div>
		<div class="teaser">
			for _, pl := range teaserPlans(pr) {
				<div class={ "plan", templ.KV("hi", pl.Recommended) }>
					if pl.Recommended {
						<span class="badge">{ p.t.Recommended }</span>
					}
					<h3>{ pl.Name }</h3>
					@planPrice(p.t, pl, false)
					if len(pl.Lines) > 0 {
						<p class="muted">{ joinLines(pl.Lines, 3, p.l) }</p>
					}
				</div>
			}
		</div>
		<p class="center muted small">{ p.t.NoHidden }</p>
		<p class="center"><a class="more" href={ templ.SafeURL(p.l.at("/pricing")) }>{ p.t.CompareAll } { p.t.Arrow }</a></p>
	</section>
	<section class="soft" aria-labelledby="h-faq">
		<div class="wrap section faq-wrap">
			<div class="faq-side">
				<span class="eyebrow">{ p.t.FAQEyebrow }</span>
				<h2 id="h-faq">{ p.t.FAQH2 }</h2>
				<p class="muted">
					{ p.t.NoAnswer }
					if p.whatsApp != "" {
						<a href={ templ.SafeURL(p.whatsApp) } rel="noopener" target="_blank">{ p.t.TalkWhatsApp }</a>
					}
				</p>
			</div>
			@faqList(home)
		</div>
	</section>
	@finalCTA(p)
}

// crumbs is a page's trail: home, then the steps between, then the page.
templ crumbs(p *pageCtx, name string, between ...crumb) {
	<nav class="crumbs" aria-label={ p.t.Crumbs }>
		<a href={ templ.SafeURL(p.l.at("/")) }>{ p.t.Home }</a> /
		for _, c := range between {
			<a href={ templ.SafeURL(p.l.at(c.path)) }>{ c.name }</a> /
		}
		<span>{ name }</span>
	</nav>
}

templ pricingPage(p *pageCtx, pr pricing) {
	<section class="dots">
		<div class="wrap page-head">
			@crumbs(p, p.t.Pricing)
			<h1>{ p.t.PricingH1 }</h1>
			<p class="lead">{ p.t.PricingLead2 }</p>
			<p class="currency">
				{ p.t.PricesIn }
				if pr.Currency == currencyEGP {
					<strong>{ p.t.CurrencyEGP }</strong> · <a href={ templ.SafeURL(p.l.at("/pricing") + "?currency=USD") } rel="nofollow">{ p.t.ShowUSD }</a>
				} else {
					<strong>{ p.t.CurrencyUSD }</strong> · <a href={ templ.SafeURL(p.l.at("/pricing") + "?currency=EGP") } rel="nofollow">{ p.t.ShowEGP }</a>
				}
			</p>
		</div>
	</section>
	<section class="wrap section tight" aria-label={ p.t.Plans }>
		<input class="cycle-in" type="radio" name="cycle" id="cycle-m" checked/>
		<input class="cycle-in" type="radio" name="cycle" id="cycle-a"/>
		<div class="cycle" role="group" aria-label={ p.t.Cycle }>
			<label for="cycle-m">{ p.t.Monthly }</label>
			<label for="cycle-a">{ p.t.Annual }</label>
		</div>
		if !pr.AnyPrice {
			<p class="notice">
				{ p.t.USDSoon }
				if p.whatsApp != "" {
					<a href={ templ.SafeURL(p.whatsApp) } rel="noopener" target="_blank">{ p.t.ContactWhatsApp }</a>.
				}
			</p>
		}
		<div class="plans">
			for _, pl := range pr.Plans {
				<div class={ "plan", templ.KV("hi", pl.Recommended) }>
					if pl.Recommended {
						<span class="badge">{ p.t.Recommended }</span>
					}
					<h2>{ pl.Name }</h2>
					@planPrice(p.t, pl, true)
					<a class={ "btn", templ.KV("primary", pl.Recommended), templ.KV("ghost", !pl.Recommended) } href={ templ.SafeURL(p.signup) }>{ planCTA(p.t, pl) }</a>
					if len(pl.Lines) > 0 {
						<ul class="ticks">
							for _, l := range pl.Lines {
								<li>
									@icon("check")
									{ l }
								</li>
							}
						</ul>
					}
				</div>
			}
		</div>
		<div class="grid3 extras">
			<div class="card"><h3>{ p.t.ExtraNoHidden }</h3><p>{ p.t.ExtraNoHiddenBody }</p></div>
			<div class="card"><h3>{ p.t.ExtraMove }</h3><p>{ p.t.ExtraMoveBody }</p></div>
			<div class="card"><h3>{ p.t.ExtraNoContract }</h3><p>{ p.t.ExtraNoContractBody }</p></div>
		</div>
	</section>
	if len(pr.Rows) > 0 {
		<section class="wrap section tight" aria-labelledby="h-compare">
			<h2 id="h-compare">{ p.t.CompareH2 }</h2>
			<div class="table-box">
				<table>
					<thead>
						<tr>
							<th scope="col">{ p.t.Feature }</th>
							for _, pl := range pr.Plans {
								<th scope="col">{ pl.Name }</th>
							}
						</tr>
					</thead>
					<tbody>
						for _, r := range pr.Rows {
							<tr>
								<th scope="row">{ r.Name }</th>
								for _, c := range r.Cells {
									<td>{ c.Text }</td>
								}
							</tr>
						}
					</tbody>
				</table>
			</div>
		</section>
	}
	@finalCTA(p)
}

templ planPrice(t *texts, pl planView, cycles bool) {
	switch  {
		case pl.Free:
			<p class="price">{ pl.FreeText }<span>{ t.Always }</span></p>
		case pl.Pays && pl.Fee != "":
			<p class="price">{ pl.Fee }<span>{ t.PerDelivered }</span></p>
		case pl.Monthly != "":
			<p class={ "price", templ.KV("m", cycles && pl.Annual != "") }>{ pl.Monthly }<span>{ t.PerMonth }</span></p>
			if cycles && pl.Annual != "" {
				<p class="price a">{ pl.Annual }<span>{ t.PerYear }</span></p>
			}
		default:
			<p class="price soon">{ t.Soon }</p>
	}
	if pl.TrialDays > 0 && !pl.Free && !pl.Pays {
		<p class="trial">{ t.Trial } { trialText(t, pl.TrialDays) }</p>
	}
}

templ faqPage(p *pageCtx, list []faq) {
	<section class="dots">
		<div class="wrap page-head">
			@crumbs(p, p.t.FAQ)
			<h1>{ p.t.FAQH1 }</h1>
			<p class="lead">{ p.t.FAQLead }</p>
		</div>
	</section>
	<section class="wrap section tight faq-page">
		@faqList(list)
	</section>
	@finalCTA(p)
}

templ faqList(list []faq) {
	<div class="faq">
		for i, f := range list {
			<details open?={ i == 0 }>
				<summary>{ f.q }</summary>
				<p>{ f.a }</p>
			</details>
		}
	</div>
}

templ finalCTA(p *pageCtx) {
	<section class="wrap section" aria-labelledby="h-cta">
		<div class="cta-card">
			<div>
				<h2 id="h-cta">{ p.t.CTAH2 }</h2>
				<p>{ p.t.CTALead }</p>
			</div>
			<div class="cta-row">
				<a class="btn primary big" href={ templ.SafeURL(p.signup) }>{ p.t.CreateFree }</a>
				if p.whatsApp != "" {
					<a class="btn outline big" href={ templ.SafeURL(p.whatsApp) } rel="noopener" target="_blank">{ p.t.TalkToUs }</a>
				}
			</div>
		</div>
	</section>
}

templ notFoundPage(p *pageCtx) {
	<section class="wrap section page-head">
		<h1>{ p.t.NotFoundH1 }</h1>
		<p class="lead">{ p.t.NotFoundLead }</p>
		<p><a class="btn primary" href={ templ.SafeURL(p.l.at("/")) }>{ p.t.HomePage }</a></p>
	</section>
}

// The illustrations: example screens, drawn in HTML, in the page's
// language.
templ heroShot(t *texts) {
	<div class="shot" aria-label={ t.ShotLabel } role="img">
		<div class="window">
			<div class="window-bar"><i></i><i></i><i></i><span dir="ltr">app.iftahonline.com</span></div>
			<div class="window-body">
				<div class="side">
					<strong>{ t.ShotStore }</strong>
					for i, n := range shotNav(t) {
						<span class={ templ.KV("on", i == 1) }>{ n }</span>
					}
				</div>
				<div class="board">
					<div class="board-head"><strong>{ t.ShotOrders }</strong><span class="chip-muted">{ t.Example }</span></div>
					<div class="stats">
						<div><span>{ t.ShotNew }</span><strong>24</strong></div>
						<div><span>{ t.ShotConfirmed }</span><strong class="ok">19</strong></div>
						<div><span>{ t.ShotHeld }</span><strong class="warn">2</strong></div>
					</div>
					<div class="rows">
						for i, r := range t.ShotRows {
							<div><span dir="ltr">{ shotRefs[i] }</span><span>{ r[0] }</span><span class={ "chip", shotChips[i] }>{ r[1] }</span><strong>{ r[2] }</strong></div>
						}
					</div>
				</div>
			</div>
		</div>
		<div class="toast">
			<span class="toast-icon">
				@icon("chat")
			</span>
			<span><strong>{ t.ToastTitle }</strong><br/>{ t.ToastOrder } <bdi dir="ltr">#7P0R1S2T</bdi> { t.ToastBody }</span>
		</div>
	</div>
}

templ chatArt(t *texts) {
	<div class="chat">
		<p class="in">{ t.ChatIn1 }</p>
		<p class="buttons"><span>{ t.ChatConfirm }</span><span>{ t.ChatCancel }</span></p>
		<p class="out">{ t.ChatConfirm }</p>
		<p class="in">{ t.ChatIn2 }</p>
	</div>
}

templ riskArt(t *texts) {
	<div class="risk">
		<div class="risk-card">
			<div class="risk-head"><strong>{ t.RiskTitle }</strong><span class="risk-high">{ t.RiskHigh }</span></div>
			<div class="meter"><i></i><i></i><i></i><i></i></div>
			<p>{ t.RiskWhy }</p>
		</div>
		<div class="risk-card">
			<strong>{ t.RiskRule }</strong>
			<div class="rules"><span class="on">{ t.RiskPrepay }</span><span>{ t.RiskHold }</span><span>{ t.RiskPhone }</span></div>
		</div>
	</div>
}

templ profitArt(t *texts) {
	<div class="profit">
		<div class="profit-card">
			<div class="profit-head"><span>{ t.ProfitHead } · <em>{ t.Example }</em></span><strong>{ t.ProfitFigures[0] }</strong></div>
			<div class="bars"><i class="b1"></i><i class="b2"></i><i class="b3"></i><i class="b4"></i><i class="b5"></i><i class="b6 loss"></i><i class="b7"></i><i class="b8"></i><i class="b9"></i><i class="b10"></i></div>
		</div>
		<dl class="profit-list">
			<div><dt>{ t.ProfitRevenue }</dt><dd>{ t.ProfitFigures[1] }</dd></div>
			<div><dt>{ t.ProfitCost }</dt><dd>{ t.ProfitFigures[2] }</dd></div>
			<div><dt>{ t.ProfitShipping }</dt><dd>{ t.ProfitFigures[3] }</dd></div>
			<div><dt>{ t.ProfitAds }</dt><dd>{ t.ProfitFigures[4] }</dd></div>
		</dl>
	</div>
}
