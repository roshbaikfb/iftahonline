package web

templ homePage(p *pageCtx, pr pricing, home []faq) {
	<section class="hero dots">
		<div class="wrap hero-in">
			<h1>المنصة التي تبني متجرك الإلكتروني <span class="accent">للدفع عند الاستلام</span></h1>
			<p class="lead">أنشئ متجرك في دقائق، وأكّد كل طلب على واتساب، واعرف العميل الذي يرفض الاستلام قبل أن تشحن له، وتابع ربحك الصافي الحقيقي. افتح أونلاين لتجار مصر والخليج.</p>
			<div class="cta-row">
				<a class="btn primary big" href={ templ.SafeURL(p.signup) }>أنشئ متجرك مجانًا</a>
				<a class="btn ghost big" href="/pricing">شاهد الأسعار</a>
			</div>
			<p class="fine">التسجيل في دقيقة · باقة مجانية دائمًا · بدون بطاقة بنكية · بلا عقد</p>
			@heroShot()
		</div>
	</section>
	<section class="works" aria-label="يعمل مع">
		<div class="wrap works-in">
			<span class="works-label">يعمل مع أدوات تعرفها</span>
			for _, w := range worksWith {
				<span class="works-name">{ w }</span>
			}
		</div>
	</section>
	<section id="features" class="wrap section" aria-labelledby="h-why">
		<div class="head">
			<span class="eyebrow">لماذا افتح أونلاين</span>
			<h2 id="h-why">صُممت حول ما يخسّر تاجر الدفع عند الاستلام</h2>
			<p>الطلبات التي لا تُؤكَّد، والطرود التي ترجع، والربح الذي لا تراه. كل أداة هنا بُنيت لواحدة منها.</p>
		</div>
		for i, f := range features {
			<div class={ "feature", templ.KV("flip", i%2 == 1) } id={ f.id }>
				<div class="feature-text">
					<span class={ "tag", f.tagClass }>{ f.tag }</span>
					<h3>{ f.title }</h3>
					<p>{ f.body }</p>
					if len(f.points) > 0 {
						<ul class="ticks">
							for _, pt := range f.points {
								<li>
									@icon("check")
									{ pt }
								</li>
							}
						</ul>
					}
				</div>
				<div class={ "feature-art", f.id } aria-hidden="true">
					switch f.id {
						case "confirm":
							@chatArt()
						case "protect":
							@riskArt()
						default:
							@profitArt()
					}
				</div>
			</div>
		}
	</section>
	<section class="wrap section" aria-labelledby="h-tools">
		<div class="head">
			<span class="eyebrow">كل الأدوات</span>
			<h2 id="h-tools">كل ما يحتاجه متجرك، في مكان واحد</h2>
		</div>
		<div class="bento">
			for _, t := range tools {
				<div class={ "tile", templ.KV("wide", t.wide) }>
					<h3>{ t.title }</h3>
					<p>{ t.body }</p>
				</div>
			}
		</div>
	</section>
	<section class="dark" aria-labelledby="h-steps">
		<div class="wrap section">
			<h2 id="h-steps" class="center">من التسجيل إلى أول طلب، في نفس اليوم</h2>
			<ol class="steps">
				for i, st := range steps {
					<li class={ templ.KV("first", i == 0) }>
						<span class="step-n">الخطوة { stepNumber(i) }</span>
						<h3>{ st.title }</h3>
						<p>{ st.body }</p>
					</li>
				}
			</ol>
		</div>
	</section>
	<section class="wrap section" aria-labelledby="h-trust">
		<div class="head">
			<span class="eyebrow">الأمان والثقة</span>
			<h2 id="h-trust">متجرك وبياناتك في أمان</h2>
		</div>
		<div class="grid4">
			for _, t := range trustItems {
				<div class="card">
					@icon(t.icon)
					<h3>{ t.title }</h3>
					<p>{ t.body }</p>
				</div>
			}
		</div>
	</section>
	<section class="wrap section" aria-labelledby="h-move">
		<div class="move">
			<div>
				<span class="tag green">مجانًا مع الاشتراك</span>
				<h2 id="h-move">عندك متجر في منصة أخرى؟ ننقله لك مجانًا</h2>
				<p>اشترك في أي باقة مدفوعة، وفريقنا ينقل منتجاتك وصورها وتصنيفاتها إلى متجرك الجديد، دون أن تتوقف مبيعاتك.</p>
				if p.whatsApp != "" {
					<a class="btn navy" href={ templ.SafeURL(p.whatsApp) } rel="noopener" target="_blank">اطلب نقل متجرك</a>
				}
			</div>
			<ol class="move-steps">
				<li><span>1</span>أرسل لنا رابط متجرك الحالي</li>
				<li><span>2</span>ننقل المنتجات والصور والتصنيفات</li>
				<li><span>3</span>تراجع متجرك الجديد وتبدأ البيع</li>
			</ol>
		</div>
	</section>
	<section class="wrap section" aria-labelledby="h-pricing">
		<div class="head">
			<span class="eyebrow">الأسعار</span>
			<h2 id="h-pricing">ابدأ مجانًا، وادفع حين تكبر</h2>
			<p>الأسعار بعملة بلدك: بالجنيه في مصر، وبالدولار في باقي الدول. كل الباقات المدفوعة تبدأ بتجربة مجانية.</p>
		</div>
		<div class="teaser">
			for _, pl := range teaserPlans(pr) {
				<div class={ "plan", templ.KV("hi", pl.Recommended) }>
					if pl.Recommended {
						<span class="badge">موصى بها</span>
					}
					<h3>{ pl.Name }</h3>
					@planPrice(pl, false)
					if len(pl.Lines) > 0 {
						<p class="muted">{ joinLines(pl.Lines, 3) }</p>
					}
				</div>
			}
		</div>
		<p class="center muted small">لا رسوم مخفية: رسوم Paymob وشركة الشحن تدفعها لهم مباشرة بأسعارهم، ولا نأخذ منها شيئًا.</p>
		<p class="center"><a class="more" href="/pricing">قارن كل الباقات ←</a></p>
	</section>
	<section class="soft" aria-labelledby="h-faq">
		<div class="wrap section faq-wrap">
			<div class="faq-side">
				<span class="eyebrow">الأسئلة الشائعة</span>
				<h2 id="h-faq">كل ما تريد معرفته عن افتح أونلاين</h2>
				<p class="muted">
					لم تجد إجابتك؟
					if p.whatsApp != "" {
						<a href={ templ.SafeURL(p.whatsApp) } rel="noopener" target="_blank">كلّمنا على واتساب</a>
					}
				</p>
			</div>
			@faqList(home)
		</div>
	</section>
	@finalCTA(p)
}

templ pricingPage(p *pageCtx, pr pricing) {
	<section class="dots">
		<div class="wrap page-head">
			<nav class="crumbs" aria-label="مسار الصفحة"><a href="/">الرئيسية</a> / <span>الأسعار</span></nav>
			<h1>أسعار واضحة، تبدأ من الصفر</h1>
			<p class="lead">ابدأ بالباقة المجانية، أو بلا اشتراك وادفع نسبة مما يُسلَّم فقط، أو اختر باقة شهرية أو سنوية. كل الباقات المدفوعة تبدأ بتجربة مجانية.</p>
			<p class="currency">
				الأسعار بـ
				if pr.Currency == currencyEGP {
					<strong>الجنيه المصري</strong> · <a href="/pricing?currency=USD" rel="nofollow">اعرضها بالدولار</a>
				} else {
					<strong>الدولار الأمريكي</strong> · <a href="/pricing?currency=EGP" rel="nofollow">اعرضها بالجنيه</a>
				}
			</p>
		</div>
	</section>
	<section class="wrap section tight" aria-label="الباقات">
		<input class="cycle-in" type="radio" name="cycle" id="cycle-m" checked/>
		<input class="cycle-in" type="radio" name="cycle" id="cycle-a"/>
		<div class="cycle" role="group" aria-label="مدة الاشتراك">
			<label for="cycle-m">شهري</label>
			<label for="cycle-a">سنوي</label>
		</div>
		if !pr.AnyPrice {
			<p class="notice">الأسعار بالدولار قريبًا. لمعرفة أسعار بلدك الآن،
				if p.whatsApp != "" {
					<a href={ templ.SafeURL(p.whatsApp) } rel="noopener" target="_blank">تواصل معنا على واتساب</a>.
				}
			</p>
		}
		<div class="plans">
			for _, pl := range pr.Plans {
				<div class={ "plan", templ.KV("hi", pl.Recommended) }>
					if pl.Recommended {
						<span class="badge">موصى بها</span>
					}
					<h2>{ pl.Name }</h2>
					@planPrice(pl, true)
					<a class={ "btn", templ.KV("primary", pl.Recommended), templ.KV("ghost", !pl.Recommended) } href={ templ.SafeURL(p.signup) }>{ planCTA(pl) }</a>
					if len(pl.Lines) > 0 {
						<ul class="ticks">
							for _, l := range pl.Lines {
								<li>
									@icon("check")
									{ l }
								</li>
							}
						</ul>
					}
				</div>
			}
		</div>
		<div class="grid3 extras">
			<div class="card"><h3>لا رسوم مخفية</h3><p>رسوم Paymob على الدفع بالبطاقة، وأسعار شركة الشحن، تدفعها لهم مباشرة بأسعارهم. لا نأخذ منها شيئًا.</p></div>
			<div class="card"><h3>نقل متجرك مجانًا</h3><p>مع أي باقة مدفوعة، ننقل منتجاتك من منصتك الحالية.</p></div>
			<div class="card"><h3>بلا عقد</h3><p>ألغِ في أي وقت من لوحة التاجر، وتبقى بياناتك ملكك.</p></div>
		</div>
	</section>
	if len(pr.Rows) > 0 {
		<section class="wrap section tight" aria-labelledby="h-compare">
			<h2 id="h-compare">قارن الباقات بالتفصيل</h2>
			<div class="table-box">
				<table>
					<thead>
						<tr>
							<th scope="col">الميزة</th>
							for _, pl := range pr.Plans {
								<th scope="col">{ pl.Name }</th>
							}
						</tr>
					</thead>
					<tbody>
						for _, r := range pr.Rows {
							<tr>
								<th scope="row">{ r.Name }</th>
								for _, c := range r.Cells {
									<td>{ c.Text }</td>
								}
							</tr>
						}
					</tbody>
				</table>
			</div>
		</section>
	}
	@finalCTA(p)
}

templ planPrice(pl planView, cycles bool) {
	switch {
		case pl.Free:
			<p class="price">{ freePrice(pl) }<span>دائمًا</span></p>
		case pl.Pays && pl.Fee != "":
			<p class="price">{ pl.Fee }<span>من كل طلب يصل لعميلك</span></p>
		case pl.Monthly != "":
			<p class={ "price", templ.KV("m", cycles && pl.Annual != "") }>{ pl.Monthly }<span>في الشهر</span></p>
			if cycles && pl.Annual != "" {
				<p class="price a">{ pl.Annual }<span>في السنة</span></p>
			}
		default:
			<p class="price soon">قريبًا</p>
	}
	if pl.TrialDays > 0 && !pl.Free && !pl.Pays {
		<p class="trial">تجربة مجانية { trialText(pl.TrialDays) }</p>
	}
}

templ faqPage(p *pageCtx, list []faq) {
	<section class="dots">
		<div class="wrap page-head">
			<nav class="crumbs" aria-label="مسار الصفحة"><a href="/">الرئيسية</a> / <span>الأسئلة الشائعة</span></nav>
			<h1>الأسئلة الشائعة عن افتح أونلاين</h1>
			<p class="lead">كل ما يسأل عنه التجار قبل أن يبدؤوا: التكاليف، والتأكيد، والحماية، ونقل المتاجر.</p>
		</div>
	</section>
	<section class="wrap section tight faq-page">
		@faqList(list)
	</section>
	@finalCTA(p)
}

templ faqList(list []faq) {
	<div class="faq">
		for i, f := range list {
			<details open?={ i == 0 }>
				<summary>{ f.q }</summary>
				<p>{ f.a }</p>
			</details>
		}
	</div>
}

templ finalCTA(p *pageCtx) {
	<section class="wrap section" aria-labelledby="h-cta">
		<div class="cta-card">
			<div>
				<h2 id="h-cta">افتح متجرك أونلاين اليوم</h2>
				<p>ابدأ بالباقة المجانية، وطوّرها حين يكبر متجرك.</p>
			</div>
			<div class="cta-row">
				<a class="btn primary big" href={ templ.SafeURL(p.signup) }>أنشئ متجرك مجانًا</a>
				if p.whatsApp != "" {
					<a class="btn outline big" href={ templ.SafeURL(p.whatsApp) } rel="noopener" target="_blank">تحدث معنا</a>
				}
			</div>
		</div>
	</section>
}

templ notFoundPage(p *pageCtx) {
	<section class="wrap section page-head">
		<h1>الصفحة غير موجودة</h1>
		<p class="lead">ربما تغيّر الرابط. ابدأ من الصفحة الرئيسية.</p>
		<p><a class="btn primary" href="/">الصفحة الرئيسية</a></p>
	</section>
}

// The home page's illustrations: example screens, drawn in HTML.

templ heroShot() {
	<div class="shot" aria-label="مثال من لوحة التاجر" role="img">
		<div class="window">
			<div class="window-bar"><i></i><i></i><i></i><span dir="ltr">app.iftahonline.com</span></div>
			<div class="window-body">
				<div class="side">
					<strong>متجر سوق</strong>
					<span>الرئيسية</span>
					<span class="on">الطلبات</span>
					<span>المنتجات</span>
					<span>رسائل العملاء</span>
					<span>الربح الصافي</span>
				</div>
				<div class="board">
					<div class="board-head"><strong>الطلبات</strong><span class="chip-muted">مثال توضيحي</span></div>
					<div class="stats">
						<div><span>طلبات جديدة</span><strong>24</strong></div>
						<div><span>أكّدها العملاء على واتساب</span><strong class="ok">19</strong></div>
						<div><span>موقوفة للمراجعة</span><strong class="warn">2</strong></div>
					</div>
					<div class="rows">
						<div><span dir="ltr">#7P0R1S2T</span><span>منى · القاهرة</span><span class="chip ok">مؤكد</span><strong>515 ج.م</strong></div>
						<div><span dir="ltr">#K8M2Q4ZX</span><span>أحمد · الجيزة</span><span class="chip info">تم الشحن</span><strong>320 ج.م</strong></div>
						<div><span dir="ltr">#3HV9TB6N</span><span>سارة · طنطا</span><span class="chip warn">موقوف للمراجعة</span><strong>450 ج.م</strong></div>
						<div><span dir="ltr">#W2N7C5LD</span><span>خالد · دبي</span><span class="chip">بانتظار التأكيد</span><strong>149 د.إ</strong></div>
					</div>
				</div>
			</div>
		</div>
		<div class="toast">
			<span class="toast-icon">
				@icon("chat")
			</span>
			<span><strong>أكّدت منى طلبها على واتساب</strong><br/>الطلب <bdi dir="ltr">#7P0R1S2T</bdi> جاهز للشحن</span>
		</div>
	</div>
}

templ chatArt() {
	<div class="chat">
		<p class="in">أهلاً منى، شكراً لطلبك من متجر سوق. رقم الطلب <bdi dir="ltr">7P0R1S2T</bdi> والإجمالي 515 ج.م. هل تؤكد الطلب؟</p>
		<p class="buttons"><span>تأكيد الطلب</span><span>إلغاء الطلب</span></p>
		<p class="out">تأكيد الطلب</p>
		<p class="in">شكراً منى، تم تأكيد طلبك. سنبلغك عند شحنه.</p>
	</div>
}

templ riskArt() {
	<div class="risk">
		<div class="risk-card">
			<div class="risk-head"><strong>تقييم العميل</strong><span class="risk-high">مخاطر مرتفعة</span></div>
			<div class="meter"><i></i><i></i><i></i><i></i></div>
			<p>رفض الاستلام مرتين في متجرين آخرين خلال الشهور الأخيرة.</p>
		</div>
		<div class="risk-card">
			<strong>قاعدتك لهذا المستوى</strong>
			<div class="rules"><span class="on">اطلب دفع التوصيل مقدمًا</span><span>أوقفه للمراجعة</span><span>تأكيد بالهاتف</span></div>
		</div>
	</div>
}

templ profitArt() {
	<div class="profit">
		<div class="profit-card">
			<div class="profit-head"><span>صافي الربح · 30 يومًا · <em>مثال توضيحي</em></span><strong>18,450 ج.م</strong></div>
			<div class="bars"><i class="b1"></i><i class="b2"></i><i class="b3"></i><i class="b4"></i><i class="b5"></i><i class="b6 loss"></i><i class="b7"></i><i class="b8"></i><i class="b9"></i><i class="b10"></i></div>
		</div>
		<dl class="profit-list">
			<div><dt>الإيراد</dt><dd>62,300 ج.م</dd></div>
			<div><dt>تكلفة المنتجات</dt><dd>−27,900 ج.م</dd></div>
			<div><dt>الشحن والمرتجعات</dt><dd>−9,750 ج.م</dd></div>
			<div><dt>الإعلانات</dt><dd>−6,200 ج.م</dd></div>
		</dl>
	</div>
}
