{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.iftahonline.com/storefront/hero.json",
  "title": "Hero",
  "description": "A large opening banner: heading, subheading and one button. The image, if any, is a product's first image.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "badge": { "description": "A short label above the heading, e.g. New collection.", "$ref": "defs.json#/$defs/line", "maxLength": 30 },
    "heading": { "description": "Empty shows the store's name.", "$ref": "defs.json#/$defs/line", "maxLength": 120 },
    "subheading": { "$ref": "defs.json#/$defs/line", "maxLength": 300 },
    "button_label": { "description": "Empty with a link shows the default (Shop now).", "$ref": "defs.json#/$defs/line", "maxLength": 40 },
    "button_link": { "$ref": "defs.json#/$defs/link" },
    "image_product_id": { "$ref": "defs.json#/$defs/id" },
    "align": { "enum": ["start", "center"], "default": "center" }
  },
  "dependentRequired": { "button_label": ["button_link"] }
}
