{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.iftahonline.com/storefront/reviews.json",
  "title": "Reviews",
  "description": "Testimonials the merchant enters (ADR-0016): name, rating and text.",
  "type": "object",
  "additionalProperties": false,
  "required": ["items"],
  "properties": {
    "title": { "$ref": "defs.json#/$defs/title" },
    "items": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "rating", "text"],
        "properties": {
          "name": { "$ref": "defs.json#/$defs/line", "minLength": 1, "maxLength": 60 },
          "location": { "$ref": "defs.json#/$defs/line", "maxLength": 60 },
          "rating": { "type": "integer", "minimum": 1, "maximum": 5 },
          "text": { "type": "string", "minLength": 1, "maxLength": 500 }
        }
      }
    }
  }
}
