{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.iftahonline.com/storefront/promo_tiles.json",
  "title": "Promo tiles",
  "description": "One to three colored tiles linking to offers or collections.",
  "type": "object",
  "additionalProperties": false,
  "required": ["items"],
  "properties": {
    "items": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "link"],
        "properties": {
          "label": { "description": "A short line above the title, e.g. Limited time.", "$ref": "defs.json#/$defs/line", "maxLength": 30 },
          "title": { "$ref": "defs.json#/$defs/line", "minLength": 1, "maxLength": 60 },
          "link": { "$ref": "defs.json#/$defs/link" },
          "tone": { "enum": ["amber", "green", "blue", "primary"], "default": "amber" }
        }
      }
    }
  }
}
