package web

import (
	"fmt"
	"strconv"
	"time"

	"github.com/roshbaikfb/iftahonline/internal/modules/ads"
	"github.com/roshbaikfb/iftahonline/internal/modules/catalog"
)

// picture is one image in AVIF and WebP at every size; the first image
// of a page loads eagerly at high priority (it is the LCP element).
templ picture(img image, sizes string, eager bool) {
	<picture>
		if img.avif != "" {
			<source type="image/avif" srcset={ img.avif } sizes={ sizes }/>
		}
		<img
			src={ img.src }
			srcset={ img.webp }
			sizes={ sizes }
			width={ strconv.Itoa(img.width) }
			height={ strconv.Itoa(img.height) }
			alt={ img.alt }
			decoding="async"
			if eager {
				fetchpriority="high"
			} else {
				loading="lazy"
			}
		/>
	</picture>
}

templ price(pv priceView) {
	<span class={ "price", templ.KV("sale", pv.compare != "") } data-price>
		{ pv.price }
		if pv.compare != "" {
			<s>{ pv.compare }</s>
		}
	</span>
}

// card is a product in a list: picture with a sold-out or discount tag,
// title, price, and on wide screens an add-to-cart button (a form when
// there is nothing to choose, else a link to the product).
templ card(p *pageCtx, pr catalog.StorefrontProduct) {
	<div class="card">
		<a class="ph" href={ p.URL(productPath(pr.Slug)) } tabindex="-1" aria-hidden="true">
			if img := imageOf(pr); img != nil {
				@picture(*img, "(min-width: 48rem) 25vw, 50vw", p.eager())
			}
			if pr.Sample {
				<span class="tag">{ p.l.T(MsgSample) }</span>
			} else if !pr.Available() {
				<span class="tag out">{ p.l.T(MsgSoldOutShort) }</span>
			} else if pct := salePercent(pr.PriceFrom()); pct > 0 {
				<span class="tag">{ fmt.Sprintf(p.l.T(MsgSalePercent), pct) }</span>
			}
		</a>
		<a class="name" href={ p.URL(productPath(pr.Slug)) }>{ pr.Title }</a>
		@price(p.priceOf(pr.PriceFrom()))
		if pr.Available() && len(pr.Variants) == 1 {
			<form class="add" method="post" action={ p.URL("/cart") }>
				<input type="hidden" name="variant" value={ pr.Variants[0].ID.String() }/>
				<input type="hidden" name="qty" value="1"/>
				<button type="submit">{ p.l.T(MsgAddToCart) }</button>
			</form>
		} else if pr.Available() {
			<a class="add" href={ p.URL(productPath(pr.Slug)) }>{ p.l.T(MsgAddToCart) }</a>
		}
	</div>
}

// sectionsPage lays sections out in a wrapping row: each takes the
// full width, except that a hero and promo tiles after it share one
// line on wide screens.
templ sectionsPage(p *pageCtx, secs []sectionView) {
	<div class="secs">
		for i, s := range secs {
			@section(p, s, i == 0)
			if i == 0 {
				@adSlot(p, ads.HomeTop)
			} else if i == 1 {
				@adSlot(p, ads.Grid)
			}
		}
	</div>
	if len(secs) == 0 {
		<p class="empty">{ p.l.T(MsgNoProducts) }</p>
	}
}

templ section(p *pageCtx, s sectionView, first bool) {
	switch {
		case s.hero != nil:
			@hero(p, s.id, s.hero, first)
		case s.grid != nil:
			@grid(p, s.id, s.grid)
		case s.cats != nil:
			@categoryTiles(p, s.id, s.cats)
		case s.promos != nil:
			<section class="promos" id={ "s-" + s.id }>
				for _, t := range s.promos.Items {
					<a class="promo" data-tone={ orString(t.Tone, "amber") } href={ p.link(t.Link) }>
						if t.Label != "" {
							<span>{ t.Label }</span>
						}
						<strong>{ t.Title }</strong>
					</a>
				}
			</section>
		case s.whatsapp != nil:
			<section class="wa" id={ "s-" + s.id }>
				@icon("chat")
				<div>
					<strong>{ p.l.Or(s.whatsapp.Title, MsgWhatsAppHelp) }</strong>
					<p>{ p.l.Or(s.whatsapp.Text, MsgWhatsAppHelpText) }</p>
				</div>
				<a href={ waLink(p.v.theme.Contact.WhatsApp) } rel="noopener" target="_blank">{ p.l.T(MsgContact) }</a>
			</section>
		case s.landing != nil:
			@productLanding(p, s.landing, first)
		case s.reviews != nil:
			<section class="sec" id={ "s-" + s.id }>
				<h2>{ p.l.Or(s.reviews.Title, MsgReviews) }</h2>
				<div class="reviews">
					for _, r := range s.reviews.Items {
						<figure class="review">
							<div class="stars" role="img" aria-label={ fmt.Sprintf(p.l.T(MsgRatingOf), r.Rating) }>{ stars(r.Rating) }</div>
							<blockquote><p>{ r.Text }</p></blockquote>
							<figcaption>
								{ r.Name }
								if r.Location != "" {
									· { r.Location }
								}
							</figcaption>
						</figure>
					}
				</div>
			</section>
		case s.faq != nil:
			<section class="sec faq" id={ "s-" + s.id }>
				<h2>{ p.l.Or(s.faq.Title, MsgFAQ) }</h2>
				for _, qa := range s.faq.Items {
					<details>
						<summary>{ qa.Question }</summary>
						<p>{ qa.Answer }</p>
					</details>
				}
			</section>
		case s.badges != nil:
			<section class="sec badges" id={ "s-" + s.id }>
				for _, b := range s.badges.Items {
					<div>
						<i>
							@badgeIcon(b.Icon)
						</i>
						<p>
							<strong>{ orString(b.Title, p.l.BadgeTitle(b.Icon)) }</strong>
							if b.Text != "" {
								<span>{ b.Text }</span>
							}
						</p>
					</div>
				}
			</section>
		case s.countdown != nil:
			@countdown(p, s.id, s.countdown)
	}
}

// hero is a banner card: the picture under a scrim, then a tag, the
// heading, a line and the button. A link without a label reads "Shop
// now".
templ hero(p *pageCtx, id string, h *heroView, first bool) {
	<section class={ "sec", "hero", templ.KV("pic", h.image != nil) } id={ "s-" + id } data-align={ orString(h.cfg.Align, "center") }>
		if h.image != nil {
			@picture(*h.image, "(min-width: 48rem) 66vw, 100vw", p.eager())
		}
		<div class="txt">
			if h.cfg.Badge != "" {
				<span class="pill">{ h.cfg.Badge }</span>
			}
			if first {
				<h1>{ orString(h.cfg.Heading, p.v.name) }</h1>
			} else {
				<h2>{ orString(h.cfg.Heading, p.v.name) }</h2>
			}
			if h.cfg.Subheading != "" {
				<p>{ h.cfg.Subheading }</p>
			}
			if h.cfg.ButtonLink != "" {
				<a class="btn" href={ p.link(h.cfg.ButtonLink) }>{ p.l.Or(h.cfg.ButtonLabel, MsgShopNow) }</a>
			}
		</div>
	</section>
}

// grid is products in rows, or in one row that scrolls sideways.
templ grid(p *pageCtx, id string, g *gridView) {
	<section class="sec" id={ "s-" + id }>
		if g.title != "" || g.more != "" {
			<div class="head">
				if g.title != "" {
					<h2>{ g.title }</h2>
				}
				if g.more != "" {
					<a href={ p.URL(g.more) }>{ p.l.T(MsgViewAll) }</a>
				}
			</div>
		}
		if len(g.products) == 0 {
			<p class="empty">{ p.l.T(MsgNoProducts) }</p>
		} else {
			<div class={ "grid", templ.KV("row", g.carousel) }>
				for _, pr := range g.products {
					@card(p, pr)
				}
			</div>
		}
	</section>
}

// categoryTiles: chips that scroll sideways on phones ("All" first, for
// the page being shown), round tiles with the name's initial on wide
// screens.
templ categoryTiles(p *pageCtx, id string, c *catsView) {
	<section class="sec tiles" id={ "s-" + id }>
		<h2>{ p.l.Or(c.title, MsgShopByCategory) }</h2>
		<nav aria-label={ p.l.Or(c.title, MsgShopByCategory) }>
			if p.active("/") {
				<a class="all" href={ p.URL("/") } aria-current="page">{ p.l.T(MsgAll) }</a>
			} else {
				<a class="all" href={ p.URL("/") }>{ p.l.T(MsgAll) }</a>
			}
			for _, cat := range c.cats {
				<a href={ p.URL(categoryPath(cat.Slug)) }><i aria-hidden="true">{ initial(cat.Name) }</i>{ cat.Name }</a>
			}
		</nav>
	</section>
}

templ productLanding(p *pageCtx, lv *landingView, first bool) {
	<section class="sec prod">
		<div class="gallery">
			for i, img := range lv.product.Images {
				if i < 5 {
					@picture(pictureOf(img, lv.product.Title), "(min-width: 48rem) 50vw, 100vw", i == 0 && p.eager())
				}
			}
		</div>
		<div>
			if first {
				<h1>{ orString(lv.cfg.Headline, lv.product.Title) }</h1>
			} else {
				<h2>{ orString(lv.cfg.Headline, lv.product.Title) }</h2>
			}
			if len(lv.cfg.Highlights) > 0 {
				<ul class="highlights">
					for _, h := range lv.cfg.Highlights {
						<li>{ h }</li>
					}
				</ul>
			}
			@quickOrder(p, lv, orString(lv.cfg.CTALabel, p.l.T(MsgOrderNow)))
			if lv.cfg.ShowDescription == nil || *lv.cfg.ShowDescription {
				<div class="desc">
					for _, para := range paragraphs(lv.product.Description) {
						<p>{ para }</p>
					}
				</div>
			}
		</div>
	</section>
}

templ countdown(p *pageCtx, id string, c *countdownView) {
	<section class="sec countdown" id={ "s-" + id } data-countdown={ c.cfg.EndsAt.UTC().Format(time.RFC3339) } data-hide={ boolAttr(c.hide) }>
		<h2>{ p.l.Or(c.cfg.Title, MsgOfferEnds) }</h2>
		if c.cfg.Subtitle != "" {
			<p>{ c.cfg.Subtitle }</p>
		}
		<div class="clock" aria-hidden="true">
			for i, unit := range []Msg{MsgDays, MsgHours, MsgMinutes, MsgSeconds} {
				<div><span data-unit>{ fmt.Sprintf("%02d", c.left[i]) }</span><small>{ p.l.T(unit) }</small></div>
			}
		</div>
	</section>
}

templ badgeIcon(icon string) {
	@templ.Raw(badgeSVG(icon))
}
