package web

import "strconv"

// layout is every storefront page: head (SEO, the store's inline
// stylesheet, structured data, our one script), header, main, footer.
templ layout(p *pageCtx, body templ.Component) {
	<!DOCTYPE html>
	<html lang={ string(p.l) } dir={ p.l.Dir() }>
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ p.title }</title>
			if p.desc != "" {
				<meta name="description" content={ p.desc }/>
			}
			if p.refresh > 0 && p.refreshTo != "" {
				<meta http-equiv="refresh" content={ strconv.Itoa(p.refresh) + ";url=" + p.refreshTo }/>
			} else if p.refresh > 0 {
				<meta http-equiv="refresh" content={ strconv.Itoa(p.refresh) }/>
			}
			if p.noindex {
				<meta name="robots" content="noindex"/>
			}
			<link rel="canonical" href={ p.abs(p.l, p.path) }/>
			<link rel="alternate" hreflang={ string(p.v.locale) } href={ p.abs(p.v.locale, p.path) }/>
			<link rel="alternate" hreflang={ string(p.v.locale.Other()) } href={ p.abs(p.v.locale.Other(), p.path) }/>
			<meta property="og:site_name" content={ p.v.name }/>
			<meta property="og:title" content={ p.title }/>
			<meta property="og:url" content={ p.abs(p.l, p.path) }/>
			if p.image != "" {
				<meta property="og:image" content={ p.image }/>
			}
			if p.font != "" {
				<link rel="preload" href={ p.font } as="font" type="font/woff2" crossorigin/>
			}
			@p.styleTag()
			if p.cssURL != "" {
				<link rel="stylesheet" href={ p.cssURL }/>
			}
			@p.ldScript()
			<script type="module" src={ p.jsURL }></script>
			if p.challenge {
				<script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
			}
		</head>
		<body
			class={ templ.KV("compact", p.head != headFull), templ.KV("soft", p.soft) }
			if p.v.theme.Look != "" {
				data-look={ string(p.v.theme.Look) }
			}
		>
			<a class="sr" href="#main">{ p.l.T(MsgSkipToContent) }</a>
			switch p.head {
				case headProduct:
					@compactHeader(p)
				case headCheckout:
					<header class="top-p">
						<a class="back" href={ p.URL(p.back) } aria-label={ p.l.T(MsgBack) }>
							@icon("back")
						</a>
						<strong class="title">{ p.l.T(MsgCheckout) }</strong>
						<span class="lock" role="img" aria-label={ p.l.T(MsgSecure) }>
							@icon("lock")
						</span>
					</header>
				case headThanks:
					<header class="top-p center">
						<a class="brand" href={ p.URL("/") }>{ p.v.name }</a>
					</header>
			}
			if p.v.theme.Announcement != "" {
				<div class="announce">{ p.v.theme.Announcement }</div>
			}
			<header class="top">
				<div class="wrap bar">
					if cats := p.v.topCategories(); len(cats) > 0 {
						<details class="menu">
							<summary>
								@icon("menu")
								<span class="sr">{ p.l.T(MsgMenu) }</span>
							</summary>
							<nav aria-label={ p.l.T(MsgMenu) }>
								<a href={ p.URL("/") }>{ p.l.T(MsgHome) }</a>
								for _, c := range cats {
									<a href={ p.URL(categoryPath(c.Slug)) }>{ c.Name }</a>
								}
							</nav>
						</details>
					}
					<a class="brand" href={ p.URL("/") }>
						if p.v.logo != nil {
							<picture>
								<source type="image/avif" srcset={ p.v.logo.avif }/>
								<img src={ p.v.logo.webp } width={ strconv.Itoa(p.v.logo.width) } height={ strconv.Itoa(p.v.logo.height) } alt={ p.v.name }/>
							</picture>
						} else {
							{ p.v.name }
						}
					</a>
					if p.search {
						@searchForm(p, "q")
					}
					<div class="tools">
						if p.track {
							<a class="track-link" href={ p.URL("/track") }>{ p.l.T(MsgTrack) }</a>
						}
						<a class="lang" href={ templ.SafeURL(p.localize(p.l.Other(), p.path)) } hreflang={ string(p.l.Other()) } lang={ string(p.l.Other()) }>
							{ p.l.Other().T(MsgLanguageName) }
						</a>
						<a class="cartlink" href={ p.URL("/cart") }>
							@icon("bag")
							<span class="lbl">{ p.l.T(MsgCart) }</span>
							<span class="count" data-cart-count hidden></span>
						</a>
					</div>
				</div>
				if cats := p.v.topCategories(); len(cats) > 0 {
					<nav class="wrap cats" aria-label={ p.l.T(MsgProducts) }>
						@navLink(p, "/", p.l.T(MsgHome))
						for _, c := range cats {
							@navLink(p, categoryPath(c.Slug), c.Name)
						}
					</nav>
				}
			</header>
			<main id="main" class="wrap">
				@body
			</main>
			@footer(p)
		</body>
	</html>
}

templ navLink(p *pageCtx, path, label string) {
	if p.active(path) {
		<a href={ p.URL(path) } aria-current="page">{ label }</a>
	} else {
		<a href={ p.URL(path) }>{ label }</a>
	}
}

// footer: what the store is, its policies, how to reach it and how
// shoppers can pay. Columns with nothing to say are left out.
templ footer(p *pageCtx) {
	<footer class="foot">
		<div class="wrap cols">
			<div>
				<strong class="name">{ p.v.name }</strong>
				if p.v.theme.About != "" {
					<p>{ p.v.theme.About }</p>
				}
			</div>
			if len(p.v.policies) > 0 || p.track {
				<div>
					<h2>{ p.l.T(MsgHelp) }</h2>
					<ul>
						for _, pol := range p.v.policies {
							<li><a href={ p.URL("/policies/" + pol.Slug) }>{ p.policyTitle(pol.Title, pol.Slug) }</a></li>
						}
						if p.track {
							<li><a href={ p.URL("/track") }>{ p.l.T(MsgTrack) }</a></li>
						}
					</ul>
				</div>
			}
			if c := p.v.theme.Contact; c.WhatsApp != "" || c.Email != "" {
				<div>
					<h2>{ p.l.T(MsgContactUs) }</h2>
					<ul>
						if c.WhatsApp != "" {
							<li>{ p.l.T(MsgWhatsApp) }: <a href={ waLink(c.WhatsApp) } dir="ltr">{ c.WhatsApp }</a></li>
						}
						if c.Email != "" {
							<li>{ p.l.T(MsgEmail) }: <a href={ mailto(c.Email) }>{ c.Email }</a></li>
						}
					</ul>
				</div>
			}
			<div>
				<h2>{ p.l.T(MsgPaymentMethods) }</h2>
				<ul>
					<li>{ p.l.T(MsgBadgeCOD) }</li>
					if p.v.cards {
						<li>{ cardBrands(p.l, p.v.country) }</li>
					}
				</ul>
			</div>
		</div>
		<p class="copy">
			© { p.v.name } · { p.l.T(MsgPoweredBy) } ·
			<a href={ templ.SafeURL(p.localize(p.l.Other(), p.path)) } hreflang={ string(p.l.Other()) } lang={ string(p.l.Other()) }>{ p.l.Other().T(MsgLanguageName) }</a>
		</p>
	</footer>
}

// icon is one of our own line icons.
templ icon(name string) {
	@templ.Raw(iconSVG(name))
}

// compactHeader is the product page's header on phones (the mockup):
// back to the product's category, the brand, share and the cart. Wide
// screens keep the full header.
templ compactHeader(p *pageCtx) {
	<header class="top-p">
		<a class="back" href={ p.URL(p.back) } aria-label={ p.l.T(MsgBack) }>
			@icon("back")
		</a>
		<a class="brand" href={ p.URL("/") }>{ p.v.name }</a>
		<div class="tools">
			<button type="button" class="share" data-share={ p.abs(p.l, p.path) } data-title={ p.title } aria-label={ p.l.T(MsgShare) } hidden>
				@icon("share")
			</button>
			<a class="cartlink" href={ p.URL("/cart") } aria-label={ p.l.T(MsgCart) }>
				@icon("bag")
				<span class="count" data-cart-count hidden></span>
			</a>
		</div>
	</header>
}
