package web

import (
	"fmt"
	"strconv"

	"github.com/roshbaikfb/iftahonline/internal/modules/catalog"
)

// productPage is the approved mockup: gallery, title and price, the
// choices, quantity, the delivery, payment and returns box, the
// description, related products, and on phones a bar that stays at the
// bottom. The form posts the product and its choices, so it works
// without JavaScript; the script follows the choice (price, stock line,
// total, WhatsApp text) and asks the delivery quote.
templ productPage(p *pageCtx, crumb *catalog.Category, v productView) {
	<nav class="crumbs" aria-label="breadcrumb">
		<a href={ p.URL("/") }>{ p.l.T(MsgHome) }</a>
		if crumb != nil {
			› <a href={ p.URL(categoryPath(crumb.Slug)) }>{ crumb.Name }</a>
		}
		› <span aria-current="page">{ v.pr.Title }</span>
	</nav>
	<div class="pd">
		@gallery(p, v)
		<div class="pd-info">
			if len(v.cats) > 0 {
				<p class="pd-cats">
					for i, c := range v.cats {
						if i > 0 {
							{ " · " }
						}
						<a href={ p.URL(categoryPath(c.Slug)) }>{ c.Name }</a>
					}
				</p>
			}
			<h1>{ v.pr.Title }</h1>
			<p class="pd-price" data-pd-price>
				<span class={ "now", templ.KV("sale", v.price.compare != "") } data-now>{ v.price.price }</span>
				<s data-was hidden?={ v.price.compare == "" }>{ v.price.compare }</s>
				<span class="saving" data-save hidden?={ v.save == "" }>{ v.save }</span>
			</p>
			<p class="left" data-left hidden?={ v.left == 0 }>
				if v.left > 0 {
					{ p.l.Left(v.left) }
				}
			</p>
			<form id="buy" class="pd-buy" method="post" action={ p.URL("/cart") } data-product data-variants={ v.variants } data-money={ v.money } data-add-label={ p.l.T(MsgAddToCart) } data-sold-label={ p.unavailable(v.pr) }>
				<input type="hidden" name="product" value={ v.pr.ID.String() }/>
				<input type="hidden" name="variant" disabled data-variant/>
				for _, o := range v.options {
					<fieldset class={ "opt", templ.KV("colors", o.color) }>
						<legend>{ o.name }: <strong data-chosen={ fmt.Sprint(o.index) }>{ o.chosen }</strong></legend>
						<div>
							for _, val := range o.values {
								<label class={ templ.KV("out", val.out), templ.KV("sw", val.swatch != ""), templ.KV(val.swatch, val.swatch != "") }>
									<input type="radio" name={ fmt.Sprintf("o%d", o.index) } value={ val.value } checked?={ val.checked } disabled?={ val.out } data-opt={ fmt.Sprint(o.index) } required/>
									if val.swatch != "" {
										<span class="sr">{ val.value }</span>
									} else {
										<span>{ val.value }</span>
									}
								</label>
							}
						</div>
					</fieldset>
				}
				<div class="qty">
					<label for="qty">{ p.l.T(MsgQuantity) }</label>
					<div class="stepper">
						<button type="button" data-step="-1" aria-label={ p.l.T(MsgLess) } hidden>−</button>
						<input type="number" id="qty" name="qty" min="1" max="20" value="1" inputmode="numeric"/>
						<button type="button" data-step="1" aria-label={ p.l.T(MsgMore) } hidden>+</button>
					</div>
				</div>
				<button class="btn btn-block add-inline" type="submit" disabled?={ !v.pr.Available() } data-add>
					if v.pr.Available() {
						{ p.l.T(MsgAddToCart) }
					} else {
						{ p.unavailable(v.pr) }
					}
				</button>
				if v.pr.Sample {
					<p class="note">{ p.l.T(MsgSampleNote) }</p>
				}
			</form>
			@infoBox(p, v)
			if desc := paragraphs(v.pr.Description); len(desc) > 0 {
				<details class="pd-desc" open>
					<summary>{ p.l.T(MsgDescription) }</summary>
					for _, para := range desc {
						<p>{ para }</p>
					}
				</details>
			}
			if c := v.pr.SizeChart; c != nil {
				<details class="pd-desc pd-size">
					<summary>{ p.l.T(MsgSizeChart) }</summary>
					<div class="scroll">
						<table>
							<caption>{ p.l.T(MsgSizeChartUnit) }</caption>
							<thead>
								<tr>
									for _, h := range c.Header {
										<th scope="col">{ h }</th>
									}
								</tr>
							</thead>
							<tbody>
								for _, row := range c.Body {
									<tr>
										for i, cell := range row {
											if i == 0 {
												<th scope="row">{ cell }</th>
											} else {
												<td>{ cell }</td>
											}
										}
									</tr>
								}
							</tbody>
						</table>
					</div>
				</details>
			}
		</div>
	</div>
	if len(v.related) > 0 {
		<section class="sec">
			<div class="head"><h2>{ p.l.T(MsgYouMayLike) }</h2></div>
			<div class="grid row">
				for _, rp := range v.related {
					@card(p, rp)
				}
			</div>
		</section>
	}
	<div class="sticky">
		if v.whatsApp != "" {
			<a class="wa-order" href={ v.whatsApp } rel="noopener" target="_blank" aria-label={ p.l.T(MsgOrderViaWhatsApp) } data-wa>
				@icon("chat")
			</a>
		}
		<button class="btn" type="submit" form="buy" disabled?={ !v.pr.Available() } data-add data-total>
			if v.pr.Available() {
				{ p.l.T(MsgAddToCart) } · { v.price.price }
			} else {
				{ p.unavailable(v.pr) }
			}
		</button>
	</div>
	<p class="toast" role="status" data-toast hidden>{ p.l.T(MsgLinkCopied) }</p>
}

// gallery scrolls sideways (snapping to each picture); the dots and the
// thumbnails are anchors to the pictures, so they work without script.
templ gallery(p *pageCtx, v productView) {
	<div class="pd-gallery">
		<div class="track" data-track>
			for i, img := range v.pr.Images {
				if i < maxGallery {
					<div class="slide" id={ fmt.Sprintf("g-%d", i+1) }>
						@picture(pictureOf(img, v.pr.Title), "(min-width: 48rem) 50vw, 100vw", i == 0 && p.eager())
					</div>
				}
			}
			if len(v.pr.Images) == 0 {
				<div class="slide empty-pic"></div>
			}
		</div>
		if v.pr.Sample {
			<span class="tag">{ p.l.T(MsgSample) }</span>
		} else if !v.pr.Available() {
			<span class="tag out">{ p.l.T(MsgSoldOutShort) }</span>
		} else if v.pct > 0 {
			<span class="tag" data-pct>{ fmt.Sprintf(p.l.T(MsgSalePercent), v.pct) }</span>
		}
		if n := min(len(v.pr.Images), maxGallery); n > 1 {
			<div class="dots" aria-hidden="true">
				for i := range n {
					<span class={ templ.KV("on", i == 0) }></span>
				}
			</div>
			<div class="thumbs">
				for i, img := range v.pr.Images {
					if i < maxGallery {
						<a href={ templ.SafeURL(fmt.Sprintf("#g-%d", i+1)) } aria-label={ fmt.Sprintf(p.l.T(MsgImageN), i+1) } class={ templ.KV("on", i == 0) }>
							@picture(pictureOf(img, ""), "4rem", false)
						</a>
					}
				}
			</div>
		}
	</div>
}

// infoBox: delivery (the quote once a governorate is chosen), payment,
// and returns when the store published its policy.
templ infoBox(p *pageCtx, v productView) {
	<div class="pd-box">
		<div class="row">
			@infoIcon("shipping")
			<div>
				if v.quote {
					<form class="deliv" data-delivery={ string(p.URL("/order/quote")) }>
						<label for="deliv-gov">{ p.l.T(MsgDeliveryPrompt) }</label>
						<select id="deliv-gov" name="governorate">
							<option value="">{ p.l.T(MsgChooseGovernorate) }</option>
							for _, a := range v.areas {
								<option value={ a.Code }>{ a.Name(string(p.l)) }</option>
							}
						</select>
						<strong data-deliv-line hidden></strong>
						<small data-ship-line hidden></small>
					</form>
				} else {
					<strong>{ p.l.T(MsgShipping) }</strong>
					<small>{ p.l.T(MsgShippingAtCheckout) }</small>
				}
			</div>
		</div>
		<div class="row">
			@infoIcon("card")
			<div>
				if p.v.cards {
					<strong>{ p.l.T(MsgPayCODOrCard) }</strong>
					<small>{ p.l.T(MsgPayCardSecure) }</small>
				} else {
					<strong>{ p.l.T(MsgPayCODOnly) }</strong>
					<small>{ p.l.T(MsgPayCODNote) }</small>
				}
			</div>
		</div>
		if v.refund != nil {
			<div class="row">
				@infoIcon("returns")
				<div>
					<strong>{ p.l.T(MsgReturns) }</strong>
					<small><a href={ p.URL("/policies/" + v.refund.Slug) }>{ p.l.T(MsgReadPolicy) }</a></small>
				</div>
			</div>
		}
	</div>
}

templ infoIcon(name string) {
	<span class="ico">
		@templ.Raw(iconSVG(name))
	</span>
}

templ categoryPage(p *pageCtx, c catalog.Category, products []catalog.StorefrontProduct, more string) {
	<nav class="crumbs" aria-label="breadcrumb">
		<a href={ p.URL("/") }>{ p.l.T(MsgHome) }</a>
		› <span aria-current="page">{ c.Name }</span>
	</nav>
	<section class="sec">
		<div class="lead">
			<h1>{ c.Name }</h1>
		</div>
		if len(products) == 0 {
			<p class="empty">{ p.l.T(MsgNoProducts) }</p>
		} else {
			<div class="grid">
				for _, pr := range products {
					@card(p, pr)
				}
			</div>
		}
		if more != "" {
			<p class="more"><a class="btn" href={ templ.SafeURL(more) }>{ p.l.T(MsgShowMore) }</a></p>
		}
	</section>
}

templ policyPage(title string, paras []string) {
	<article class="policy">
		<h1>{ title }</h1>
		for _, para := range paras {
			<p>{ para }</p>
		}
	</article>
}

templ notFoundPage(p *pageCtx) {
	<section class="sec lost">
		<div class="big" aria-hidden="true">404</div>
		<h1>{ p.l.T(MsgNotFoundTitle) }</h1>
		<p>{ p.l.T(MsgNotFoundText) }</p>
		<a class="btn" href={ p.URL("/") }>{ p.l.T(MsgBackHome) }</a>
	</section>
}

// searchPage is /search: what matched as cards, the count and the next
// page; nothing matched, the categories to browse; no text yet, a prompt.
templ searchPage(p *pageCtx, v searchView) {
	<section class="sec search-page">
		if v.q == "" {
			<h1>{ p.l.T(MsgSearchLabel) }</h1>
			<p class="muted">{ p.l.T(MsgSearchPrompt) }</p>
			@searchForm(p, "search-page-q")
		} else if len(v.items) == 0 {
			<h1>{ fmt.Sprintf(p.l.T(MsgNoResults), v.q) }</h1>
			<p class="muted">{ p.l.T(MsgNoResultsHint) }</p>
			if cats := p.v.topCategories(); len(cats) > 0 {
				<nav class="tiles chips" aria-label={ p.l.T(MsgShopByCategory) }>
					for _, c := range cats {
						<a href={ p.URL(categoryPath(c.Slug)) }>{ c.Name }</a>
					}
				</nav>
			}
		} else {
			<div class="lead">
				<h1>{ fmt.Sprintf(p.l.T(MsgSearchFor), v.q) }</h1>
				<small>{ p.l.Results(v.total) }</small>
			</div>
			<div class="grid">
				for _, pr := range v.items {
					@card(p, pr)
				}
			</div>
			if v.more != "" {
				<p class="more"><a class="btn" href={ templ.SafeURL(v.more) }>{ p.l.T(MsgShowMore) }</a></p>
			}
		}
	</section>
}

// searchForm is the search box: a plain GET form, so it works without
// script.
templ searchForm(p *pageCtx, id string) {
	<form class="search" action={ p.URL("/search") } method="get" role="search">
		<label class="sr" for={ id }>{ p.l.T(MsgSearchLabel) }</label>
		<input type="search" id={ id } name="q" value={ p.q } placeholder={ p.l.T(MsgSearchPlaceholder) } maxlength="100" autocomplete="off" enterkeyhint="search"/>
	</form>
}

// trackPage is /track: the order number and phone, then where the order
// stands in steps and its parcel. The phone is never shown back.
templ trackPage(p *pageCtx, v trackView) {
	<section class="checkout track">
		<h1>{ p.l.T(MsgTrack) }</h1>
		if v.t == nil {
			<p class="muted">{ p.l.T(MsgTrackIntro) }</p>
		}
		if v.problem != 0 {
			<p class="alert" role="alert">{ p.l.T(v.problem) }</p>
		}
		<form class="card-box order" method="post" action={ p.URL("/track") }>
			<div class="fld">
				<label for="t-order">{ p.l.T(MsgOrderNumber) }</label>
				<input type="text" id="t-order" name="order" value={ v.code } required maxlength="20" autocomplete="off" dir="ltr" autocapitalize="characters" placeholder="P0R1S2T3"/>
			</div>
			<div class="fld">
				<label for="t-phone">{ p.l.T(MsgPhone) }</label>
				<input type="tel" id="t-phone" name="phone" required maxlength="32" autocomplete="tel" inputmode="tel" dir="ltr"/>
			</div>
			<button class="btn btn-block" type="submit">{ p.l.T(MsgTrackButton) }</button>
		</form>
		if v.t != nil {
			<section class="card-box">
				<h2>{ p.l.T(MsgOrderNo) } <bdi dir="ltr">#{ v.t.Code }</bdi></h2>
				<p class="muted">{ p.l.Pieces(v.t.Items) } · { p.l.Price(v.t.Total) }</p>
				if v.alert != 0 {
					<p class="alert" role="status">{ p.l.T(v.alert) }</p>
				}
				<ol class="steps">
					for i, st := range v.steps {
						<li class={ templ.KV("done", st.state == "done"), templ.KV("now", st.state == "now") }>
							<span class="n">{ strconv.Itoa(i + 1) }</span>
							<div><strong>{ p.l.T(st.label) }</strong></div>
						</li>
					}
				</ol>
				if v.t.Parcel != nil {
					<p class="parcel">{ fmt.Sprintf(p.l.T(MsgCarrierWith), p.l.carrierName(v.t.Parcel.Carrier)) } · { p.l.T(MsgTrackingNumber) }: <bdi dir="ltr">{ v.t.Parcel.Number }</bdi></p>
				}
			</section>
		}
	</section>
}

templ confirmPage(p *pageCtx, v ConfirmView, action templ.SafeURL) {
	<section class="checkout track confirm">
		<h1>{ p.l.T(MsgConfirmTitle) }</h1>
		<section class="card-box">
			<h2>{ p.l.T(MsgOrderNo) } <bdi dir="ltr">#{ v.Code }</bdi></h2>
			<p class="muted">{ p.l.Price(v.Total) }</p>
			switch v.State {
				case ConfirmWaiting:
					<p>{ fmt.Sprintf(p.l.T(MsgConfirmAsk), v.FirstName) }</p>
					<form method="post" action={ action }>
						<button class="btn btn-block" type="submit" name="answer" value="confirm">{ p.l.T(MsgConfirmYes) }</button>
					</form>
					<form method="post" action={ action }>
						<button class="btn btn-block btn-ghost" type="submit" name="answer" value="cancel">{ p.l.T(MsgConfirmNo) }</button>
					</form>
				case ConfirmDone:
					<p class="confirm-ok" role="status">{ p.l.T(MsgConfirmDone) }</p>
				case ConfirmCancelled:
					<p class="alert" role="status">{ p.l.T(MsgConfirmCancelledByYou) }</p>
				default:
					<p class="muted" role="status">{ p.l.T(MsgConfirmClosed) }</p>
			}
		</section>
	</section>
}
